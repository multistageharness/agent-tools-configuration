{
  "name": "@multistageharness/config-discovery",
  "version": "0.1.0",
  "description": "Load a package's configuration from ./.config/<packageName>/ with a fallback to ~/.config/<packageName>/, layered so project-local wins.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/conformance"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run && npm run conformance",
    "conformance": "node ../spec/runner/run.mjs --probe ts"
  },
  "dependencies": {
    "cosmiconfig": "^9.0.0",
    "dotenv": "^16.4.5",
    "smol-toml": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}

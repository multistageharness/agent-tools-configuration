#!/bin/sh
# The PROBE.md entry point for packages/java.
#
# One fat jar, built once, then `java -jar` per fixture. Not `gradle run`: seventeen fixtures
# times a Gradle daemon check is slow enough that people stop running the suite.
set -e
cd "$(dirname "$0")/.."

JAR=core/build/libs/probe.jar
needs_build=0
if [ ! -f "$JAR" ]; then
  needs_build=1
elif [ -n "$(find core/src build.gradle.kts core/build.gradle.kts -newer "$JAR" -print -quit 2>/dev/null)" ]; then
  needs_build=1
fi

if [ "$needs_build" -eq 1 ]; then
  # Build chatter is a diagnostic: stdout belongs to the JSON document alone (PROBE.md §4).
  ./gradlew --quiet :core:probeJar >&2
fi

# TieredStopAtLevel=1 and Xshare:auto cut JVM startup; the probe runs for milliseconds and never
# benefits from the C2 compiler.
exec java -XX:TieredStopAtLevel=1 -Xshare:auto -jar "$JAR" "$@"
